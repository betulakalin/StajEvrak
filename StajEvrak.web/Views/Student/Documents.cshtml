@using StajEvrak.Core.Entities
@model List<Document>
@{
    ViewData["Title"] = "Belgelerim";
}

<h2 class="mb-4">Belgelerim</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>Henüz belge yüklemediniz.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Dosya</th><th>Yüklenme Tarihi</th><th>Durum</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                var badge = d.Status switch
                {
                    DocumentStatus.Yuklendi => ("bg-secondary", "Yüklendi"),
                    DocumentStatus.Inceleniyor => ("bg-info", "İnceleniyor"),
                    DocumentStatus.HataliEksik => ("bg-danger", "Hatalı / Eksik"),
                    DocumentStatus.Onaylandi => ("bg-primary", "Onaylandı"),
                    DocumentStatus.Tamamlandi => ("bg-success", "Tamamlandı"),
                    _ => ("bg-light", d.Status.ToString())
                };
                <tr>
                    <td>@d.OriginalFileName</td>
                    <td>@d.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="badge @badge.Item1">@badge.Item2</span></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-primary">Bilgiler / Rapor</a>
                        <a asp-action="Download" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">İndir</a>
                        @if (!d.IsCompleted)
                        {
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu belgeyi silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Upload" class="btn btn-primary">Yeni Evrak Yükle</a>
<a asp-action="Index" class="btn btn-outline-secondary">Geri</a>