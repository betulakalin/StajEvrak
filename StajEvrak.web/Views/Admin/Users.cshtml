@model List<StajEvrak.Core.Entities.Student>
@{
    ViewData["Title"] = "Öğrenci Hesapları";
}

<h2 class="mb-4">Öğrenci Hesapları</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Kullanıcı adı</th>
            <th>E-posta</th>
            <th>Öğrenci no</th>
            <th>Hatalı deneme</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Username</td>
                <td>@s.Email</td>
                <td>@s.StudentNo</td>
                <td>@s.FailedLoginCount</td>
                <td>
                    @if (s.IsLocked)
                    {
                        <span class="badge bg-danger">Kilitli</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                </td>
                <td>
                    @if (s.IsLocked)
                    {
                        <form asp-action="Unlock" asp-route-id="@s.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-warning">Kilidi Aç</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Geri</a>